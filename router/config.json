{
  "endpoints": {
    "llama-cpp": {
      "host": "op.local",
      "port": 11500,
      "path_prefix": "/llama-cpp"
    },
    "firecrawl": {
      "host": "op.local",
      "port": 3002,
      "path_prefix": "/firecrawl"
    },
    "image-gen": {
      "host": "op.local",
      "port": 11903,
      "path_prefix": "/image"
    },
    "searxng": {
      "host": "op.local",
      "port": 0,
      "path_prefix": "/searx",
      "enabled": false
    },
    "openrouter": {
      "host": "openrouter.ai",
      "port": 443,
